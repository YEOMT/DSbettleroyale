{
  "name": "dsbettleroyale",
  "version": "33.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "baseline:extract": "node tools/baseline/extract.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:parity": "node --test tests/parity/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:e2e": "playwright test",
    "test:load": "node tools/load/run.mjs",
    "verify": "node tools/verify.mjs",
    "build": "node tools/build.mjs",
    "dev": "node tools/dev.mjs",
    "start:server": "node dist/server/main.js",
    "test:fidelity": "node tests/fidelity/regression.mjs && node tests/fidelity/contracts.mjs && node tests/fidelity/visuals.mjs && node tests/fidelity/reference.mjs",
    "test:fidelity-audit": "node tests/fidelity-v33-2/run.mjs",
    "quick": "node tools/ci/quick.mjs",
    "test:targeted": "node tools/ci/targeted.mjs",
    "content:generate": "node tools/content/generate.mjs",
    "content:check": "node tools/content/generate.mjs --check"
  },
  "dependencies": {
    "pixi.js": "8.20.1",
    "qrcode": "1.5.4",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "acorn": "8.15.0",
    "acorn-walk": "8.3.4",
    "esbuild": "0.28.2",
    "eslint-scope": "8.4.0",
    "vite": "7.3.7",
    "yaml": "2.9.1"
  }
}
